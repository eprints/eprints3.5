#!/usr/bin/perl -w

use FindBin;
use lib "$FindBin::Bin/../perl_lib";

######################################################################
#
#
######################################################################


=pod

=for Pod2Wiki

=head1 NAME

B<indexer> - Indexing daemon for EPrints. Intended to be run from systemd: systemd/epindexer.service

=head1 SYNOPSIS

B<indexer> --help

=head1 DESCRIPTION

This daemon runs in the background and runs background jobs for EPrints, including creating index files for all eprints repositories (hence the name).

Messages and errors are logged to STDOUT/STDERR and can be read via `journalctl -u epindexer`

=over 8

=back

=head1 OPTIONS

=over 8

=item B<--help>

Print a brief help message and exit.

=item B<--man>

Print the full manual page and then exit.

=item B<--quiet>

Be vewwy vewwy quiet. This option will suppress all output unless an error occurs.

=item B<--verbose>

Explain in detail what is going on.
May be repeated for greater effect.

=item B<--clear>

Clear broken event queue items (items that are "inprogress" or "failed") before commencing.

=item B<--retry>

Retry broken event queue items (items that are "inprogress" or "failed") before commencing.

=item B<--loglevel> I<level>

Set the level of detail to log. Level may be 0-6.

=item B<--timeout> I<seconds>

Set the maximum run time for an indexing task before an alarm is raised. EPrints::Index::Daemon uses a default value of 600 seconds.

=item B<--once>

Only clear the current queue of things needing indexing then exit.

=item B<--version>

Output version information and exit.

=back   

=head1 Making into a service.

The systemd service file has only been tested on Red Hat. For other distros it may need modifying to use the correct service names of its dependencies.

Symlink epindexer.service into systemd/service:

`sudo ln -s /opt/eprints3/systemd/epindexer.service /etc/systemd/system/`

Enable and start the service:

`sudo systemctl enable epindexer --now`

=cut

BEGIN {
	$ENV{IGNORE_UNKNOWN_ARCHIVE} = 1;
}

use EPrints;
use strict;
use Getopt::Long;
use Pod::Usage;

my $version = 0;
my $verbose = 0;
my $quiet = 0;
my $help = 0;
my $man = 0;

my $loglevel;
my $once = 0;
my $opt_clear;
my $opt_retry;
my $opt_timeout;
my $opt_kill;

Getopt::Long::Configure("permute");

GetOptions( 
	'help|?' => \$help,
	'man' => \$man,
	'version' => \$version,
	'verbose+' => \$verbose,
	'silent' => \$quiet,
	'quiet' => \$quiet,
	'once' => \$once,
	'loglevel=s' => \$loglevel,
	'clear' => \$opt_clear,
	'retry' => \$opt_retry,
	'kill' => \$opt_kill,
	'timeout=s' => \$opt_timeout,
) || pod2usage( 2 );
EPrints::Utils::cmd_version( "indexer" ) if $version;
pod2usage( 1 ) if $help;
pod2usage( -exitstatus => 0, -verbose => 2 ) if $man;
# pod2usage( 2 ) if( scalar @ARGV != 1 );

our $noise = 1;
$noise = 0 if( $quiet );
$noise = 1+$verbose if( $verbose );

if( scalar @ARGV > 0 && $ARGV[0] eq "debug" )
{
	$loglevel = 5;
	$once = 1;
}


$loglevel += 0 if defined $loglevel;
$opt_timeout += 0 if defined $opt_timeout;

my $daemon = EPrints::Index::Daemon->new(
	loglevel => $loglevel,
	noise => $noise,
	timeout => $opt_timeout,
);

if( $opt_kill )
{
	# Create the suicide file, which should cause a running process to die.
	# Useful if user doesn't have permissions to restart systemd service

	my $success = $daemon->create_suicide_file();

	if (!$success)
	{
		print "Failed to create suicide file\n";
	}
}
else
{
	if( $opt_clear || $opt_retry )
	{
		my $eprints = EPrints->new;
		print "Processing stale events\n" if $verbose;
		foreach my $repoid ($eprints->repository_ids())
		{
			my $repo = $eprints->repository( $repoid );
			my $result = $repo->dataset( "event_queue" )->search(
				filters => [
					{ meta_fields => [qw( status )], value => "inprogress failed", match => "IN", merge => "ANY" },
			]);
			$result->map(sub {
				my( undef, undef, $event ) = @_;

				if( $opt_clear )
				{
					$event->remove();
				}
				else
				{
					$event->set_value( "status", "waiting" );
					$event->commit;
				}
			});
			print "".($opt_clear ? "Removed " : "Retrying ").$result->count()." stale events\n" if $verbose;
		}
	}

	start();
}

sub start
{
	$daemon->run_index();
}

